# Sitio Mavic: página de error, compresión y caché de archivos estáticos.
ErrorDocument 404 /mavic/404.html

<IfModule mod_expires.c>
  ExpiresActive On
  # Las páginas no se guardan: un cambio de texto se ve apenas se sube, sin tener que forzar la recarga.
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json
</IfModule>
